# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Didit.me KYC Configuration
DIDIT_API_KEY=your_didit_api_key
DIDIT_WORKFLOW_ID=your_didit_workflow_id

# Xendit Payment Gateway Configuration
XENDIT_SECRET_KEY=your_xendit_secret_key
XENDIT_WEBHOOK_VERIFICATION_TOKEN=your_xendit_webhook_token

# Email SMTP Provider
SMTP_PROVIDER=Alibaba Cloud DirectMail via Supabase Custom SMTP
